# Copy to pipeline.env; Bash configuration (trusted local file).
PROJECT_ROOT="."
PYTHON_BIN="/venv/main/bin/python3 "  # Or /workspace/venv/bin/python
COHORTS="blca brca coadread hnsc stad"    # Full run: blca brca coadread hnsc stad
FOLDS="0 1 2 3 4"
EXPERIMENT="factory_3"
# OUTPUT_DIR="/workspace/runs/factory_v1" # Optional absolute override
INSTALL_DEPS=1
DOWNLOAD_DATA=1
RUN_PREFLIGHT=1
REQUIRE_CUDA=1
START_TENSORBOARD=0
TENSORBOARD_PORT=6006
# Existing Drive data ZIP URLs go in drive_setup/drive_manifest.json.
# Set enabled=false on metadata/splits entries if already present in PROJECT_ROOT.

# Optional result upload; configure rclone auth once before enabling.
ENABLE_DRIVE_BACKUP=0
DRIVE_REMOTE="gdrive"
DRIVE_FOLDER_ID="1pF79Xb3RawVlxb4Jq1ZRO9AedaZIBjR9" # Existing Drive folder ID; no public sharing required for output.
BACKUP_INTERVAL=3000
BACKUP_TIMEOUT=900
