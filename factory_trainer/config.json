{
  "output": "runs/factory_v1",
  "folds": [
    0,
    1,
    2,
    3,
    4
  ],
  "factory_class": "dataset.DatasetFactory:SurvivalDatasetFactory",
  "model_class": "model:MultiModelWeibull",
  "criterion_class": "block.loss:PIBDWeibullLoss",
  "evaluate_test": true,
  "factory_kwargs": {
    "omic_format": "pathways",
    "n_bins": 4,
    "label_col": "survival_months_dss",
    "num_patches": 4096,
    "mode": "None",
    "print_info": false
  },
  "model_kwargs": {
    "input_dim": 768,
    "hidden_dim": 128,
    "num_proxies": 8,
    "top_k": 256,
    "sample_num": 30,
    "num_member": 16
  },
  "criterion_kwargs": {
    "hidden_dim": 128,
    "survival_weight": 1.0,
    "proxy_weight": 0.5,
    "kl_weight": 1e-2,
    "alignment_weight": 1.0,
    "mi_weight": 0.5,
    "expectation_mse_weight": 0.001,
    "expectation_eps": 1e-7,
    "lambda_floor": 1e-4,
    "lambda_penalty_weight": 1e-3
  },
  "training": {
    "epochs": 50,
    "patience": 15,
    "lr": 0.0001,
    "club_lr": 0.0001,
    "weight_decay": 0.0001,
    "batch_size": 256,
    "eval_batch_size": 256,
    "workers": 0,
    "seed": 42,
    "clip": 5.0,
    "plot_every": 5,
    "plot_cases": 3,
    "train_eval_every": 5,
    "val_auxiliary": true,
    "poe_names": [
      "histology",
      "pathway"
    ]
  },
  "cohorts": {
    "blca": {
      "split_template": "5foldcv/tcga_blca/splits_{fold}.csv",
      "factory_kwargs": {
        "label_file": "datasets_csv/metadata/tcga_blca.csv",
        "omics_file": "datasets_csv/raw_rna_data/combine/blca/rna_clean.csv",
        "clinical_file": "datasets_csv/clinical_data/tcga_blca_clinical.csv",
        "signature_file": "datasets_csv/metadata/combine_signatures.csv",
        "wsi_dir": "WSIs/blca-003/pt_files"
      }
    },
    "brca": {
      "split_template": "5foldcv/tcga_brca/splits_{fold}.csv",
      "factory_kwargs": {
        "label_file": "datasets_csv/metadata/tcga_brca.csv",
        "omics_file": "datasets_csv/raw_rna_data/combine/brca/rna_clean.csv",
        "clinical_file": "datasets_csv/clinical_data/tcga_brca_clinical.csv",
        "signature_file": "datasets_csv/metadata/combine_signatures.csv",
        "wsi_dir": "WSIs/brca-004/brca/pt_files"
      }
    },
    "coadread": {
      "split_template": "5foldcv/tcga_coadread/splits_{fold}.csv",
      "factory_kwargs": {
        "label_file": "datasets_csv/metadata/tcga_coadread.csv",
        "omics_file": "datasets_csv/raw_rna_data/combine/coadread/rna_clean.csv",
        "clinical_file": "datasets_csv/clinical_data/tcga_coadread_clinical.csv",
        "signature_file": "datasets_csv/metadata/combine_signatures.csv",
        "wsi_dir": "WSIs/coadread-005/pt_files"
      }
    },
    "hnsc": {
      "split_template": "5foldcv/tcga_hnsc/splits_{fold}.csv",
      "factory_kwargs": {
        "label_file": "datasets_csv/metadata/tcga_hnsc.csv",
        "omics_file": "datasets_csv/raw_rna_data/combine/hnsc/rna_clean.csv",
        "clinical_file": "datasets_csv/clinical_data/tcga_hnsc_clinical.csv",
        "signature_file": "datasets_csv/metadata/combine_signatures.csv",
        "wsi_dir": "WSIs/hnsc-001/pt_files"
      }
    },
    "stad": {
      "split_template": "5foldcv/tcga_stad/splits_{fold}.csv",
      "factory_kwargs": {
        "label_file": "datasets_csv/metadata/tcga_stad.csv",
        "omics_file": "datasets_csv/raw_rna_data/combine/stad/rna_clean.csv",
        "clinical_file": "datasets_csv/clinical_data/tcga_stad_clinical.csv",
        "signature_file": "datasets_csv/metadata/combine_signatures.csv",
        "wsi_dir": "WSIs/stad-002/pt_files"
      }
    }
  }
}